# RootTrace 8D configuration. Copy to .env and fill in. Never commit .env.

# --- AMD inference (OpenAI-compatible) -------------------------------------
# AMD TokenFactory: base URL shown after login at https://notebooks.amd.com/tokenfactory
# vLLM on AMD Developer Cloud (MI300X): http://<droplet-ip>:8000/v1 (start vLLM with --api-key)
AMD_LLM_BASE_URL=
AMD_LLM_API_KEY=
# Model IDs: pick from GET <base_url>/models
AMD_TEXT_MODEL=
# A vision-capable model. A Gemma model is preferred (Google prize eligibility).
AMD_VISION_MODEL=
# Optional: a different AMD endpoint and key for the vision step (for example Gemma on your own vLLM)
AMD_VISION_BASE_URL=
AMD_VISION_API_KEY=
# Shown in the UI's AMD inference trace. Must truthfully describe the hardware or service.
AMD_PROVIDER_LABEL=AMD TokenFactory · AMD Instinct GPU

# --- Behaviour --------------------------------------------------------------
# auto: live when key, base URL and model are set, otherwise mock | live | mock
LLM_MODE=auto
LLM_MAX_CONCURRENCY=8
LLM_MAX_RPM=20
LLM_TIMEOUT_S=90
LLM_MAX_ATTEMPTS=3
# Optional, for reasoning models (none|low|medium). Leave empty to use the model default.
LLM_REASONING_EFFORT=

# --- App --------------------------------------------------------------------
CASE_TTL_S=7200
MAX_CASES=300
MAX_UPLOAD_MB=10
# Live analyses per client IP per window (protects the shared AMD quota)
LIVE_RUNS_PER_IP=5
LIVE_WINDOW_S=600
PORT=7860
